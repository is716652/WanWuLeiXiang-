  public getGuaShuList(): GuaShuItem[] {
    return this.guaShuList;
  }

  public getGuaShuByIndex(index: number): GuaShuItem | null {
    if (index >= 0 && index < this.guaShuList.length) {
      return this.guaShuList[index];
    }
    return null;
  }

  public searchGuaShu(keyword: string): GuaShuItem[] {
    if (!keyword) {
      return this.guaShuList;
    }
    return this.guaShuList.filter(item =>
      item.卦名.includes(keyword) ||
      item.简义.includes(keyword)
    );
