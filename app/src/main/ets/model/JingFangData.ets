  }

  public getGuaByGong(gong: string): JingFangGuaItem[] {
    return this.baguaList.filter(item => item.宫属 === gong);
  }

  public searchGua(keyword: string): JingFangGuaItem[] {
    if (!keyword) {
      return this.baguaList;
    }
    return this.baguaList.filter(item =>
      item.卦名.includes(keyword) ||
      item.宫属.includes(keyword) ||
      item.世次.includes(keyword)
    );
  }
